# Copier ce fichier en `.env` puis remplacer les valeurs.
# Le fichier `.env` est ignoré par git : il ne doit jamais être commité.

# --- PostgreSQL (base interne de n8n) ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=n8n

# --- n8n ---
# Générer une clé : openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-moi
TIMEZONE=Europe/Paris
