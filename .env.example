# Copy this file to `.env` and replace the values.
# `.env` is ignored by git: it must never be committed.

# --- PostgreSQL (n8n internal database) ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n

# --- n8n ---
# Generate a key with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me
TIMEZONE=Europe/Paris
