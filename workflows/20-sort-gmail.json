    {
      "parameters": {
        "jsCode": "// Maps each classify-email category id to its Gmail label and archive setting.\nconst CATEGORY_LABELS = {\n  subscriptions: { label: 'Subscriptions', archive: true },\n  invoices: { label: 'Invoices', archive: true },\n  jobs: { label: 'Jobs', archive: true },\n  admin: { label: 'Admin', archive: true },\n  orders: { label: 'Orders', archive: true },\n  personal: { label: 'Personal', archive: true },\n  security: { label: 'Security', archive: true },\n  trash: { label: 'Junk', archive: true },\n  other: { label: 'Other', archive: true },\n  // Kept in the inbox: there is no preview, so uncertain emails stay visible for a manual check.\n  notSure: { label: 'Not sure', archive: false },\n};\n\nconst labelIdsByName = Object.fromEntries(\n  $input.all().map((gmailLabel) => [gmailLabel.json.name, gmailLabel.json.id]),\n);\n\nreturn $('Attach category').all().map((email) => {\n  const { label, archive } = CATEGORY_LABELS[email.json.category] ?? CATEGORY_LABELS.notSure;\n  const labelName = `LLMailSorter/${label}`;\n  const labelId = labelIdsByName[labelName];\n  if (!labelId) {\n    throw new Error(`Gmail label \"${labelName}\" not found. Run \"01 - Create Gmail labels\" first.`);\n  }\n  return { json: { ...email.json, labelName, labelId, archive } };\n});"
      },
