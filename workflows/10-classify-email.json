        "jsonBody": "={\n  \"model\": \"gemini-decision-1\",\n  \"input\": {{ JSON.stringify(\"From: \" + ($json.sender ?? '') + \"\\nSubject: \" + ($json.subject ?? '') + \"\\n\\n\" + ($json.bodyStart ?? '').slice(0, 500)) }},\n  \"questions\": {\n    \"category\": {\n      \"type\": \"choice\",\n      \"instructions\": \"You are sorting a personal inbox. Which category best fits this email?\",\n      \"criteria\": {\n        \"subscriptions\": \"Newsletters and mailing lists the user chose to follow, with no payment involved.\",\n        \"invoices\": \"Invoices, receipts and payment confirmations for any amount, including renewals of paid service subscriptions.\",\n        \"jobs\": \"Job offers, applications, recruiters, job boards and work contracts.\",\n        \"admin\": \"Government, taxes, bank, insurance, health and utility paperwork.\",\n        \"orders\": \"Order confirmations, shipping notices and delivery tracking.\",\n        \"personal\": \"Emails personally written by friends or family.\",\n        \"security\": \"Login alerts, password resets, verification codes and account security warnings.\",\n        \"trash\": \"Spam, unsolicited ads, promotions and suspicious emails.\",\n        \"other\": \"None of the other categories clearly fits.\"\n      }\n    }\n  }\n}",
        "options": {}
      },
