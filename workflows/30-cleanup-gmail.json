      "parameters": {
        "jsCode": "// Retention rules: one row per Gmail label, easy to tune.\n// Starred emails are never trashed, whatever the rule.\n// readOnly: true = only emails already opened are trashed (unread ones wait for the Everything rule).\nconst RETENTION_RULES = [\n  { label: null,                       keepDays: 1095, readOnly: false }, // Everything\n  { label: 'LLMailSorter/Junk',          keepDays: 7,    readOnly: true },\n  { label: 'LLMailSorter/Subscriptions', keepDays: 30,   readOnly: true },\n  { label: 'LLMailSorter/Security',      keepDays: 30,   readOnly: true },\n  { label: 'LLMailSorter/Not sure',      keepDays: 30,   readOnly: true },\n  { label: 'LLMailSorter/Other',         keepDays: 30,   readOnly: true },\n  { label: 'LLMailSorter/Orders',        keepDays: 180,  readOnly: true },\n  { label: 'LLMailSorter/Jobs',          keepDays: 730,  readOnly: true },\n];\n\n// Builds the Gmail search query matching the emails a rule should trash.\nfunction buildQuery(rule) {\n  const parts = [`older_than:${rule.keepDays}d`, '-is:starred'];\n  if (rule.label) parts.push(`label:\"${rule.label}\"`);\n  if (rule.readOnly) parts.push('-is:unread');\n  return parts.join(' ');\n}\n\nreturn RETENTION_RULES.map(rule => ({\n  json: { ...rule, query: buildQuery(rule) },\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "40204e2c-09cc-41f7-882c-9f9a5299f185",
      "name": "Retention rules"
    },
    {
