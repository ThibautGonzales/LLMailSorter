    {
      "parameters": {
        "jsCode": "// Retention rules: one row per LLMailSorter sub-folder, easy to tune.\n// Flagged emails are never moved, whatever the rule.\n// readOnly: true = only emails already opened are moved (unread ones wait for the Everything rule).\nconst RETENTION_RULES = [\n  { folder: null,            keepDays: 1095, readOnly: false }, // Everything\n  { folder: 'Junk',          keepDays: 7,    readOnly: true },\n  { folder: 'Subscriptions', keepDays: 30,   readOnly: true },\n  { folder: 'Security',      keepDays: 30,   readOnly: true },\n  { folder: 'Not sure',      keepDays: 30,   readOnly: true },\n  { folder: 'Other',         keepDays: 30,   readOnly: true },\n  { folder: 'Orders',        keepDays: 180,  readOnly: true },\n  { folder: 'Jobs',          keepDays: 730,  readOnly: true },\n];\n\nconst parentFolder = $('Get LLMailSorter folders').first().json.value[0];\nif (!parentFolder) {\n  throw new Error('Outlook folder \"LLMailSorter\" not found. Run \"02 - Create Outlook folders\" first.');\n}\nconst folderIdsByName = Object.fromEntries(\n  parentFolder.childFolders.map((folder) => [folder.displayName, folder.id]),\n);\nconst deletedItemsId = $input.first().json.id;\n\n// Builds the Microsoft Graph path and OData filter matching the emails a rule should move.\nfunction buildRequest(rule) {\n  const cutoff = new Date(Date.now() - rule.keepDays * 24 * 60 * 60 * 1000).toISOString();\n  const conditions = [`receivedDateTime lt ${cutoff}`, \"flag/flagStatus ne 'flagged'\"];\n  if (rule.readOnly) conditions.push('isRead eq true');\n\n  if (!rule.folder) {\n    // Everything: all folders, sent emails included, except what is already in Deleted Items.\n    conditions.push(`parentFolderId ne '${deletedItemsId}'`);\n    return { path: '/me/messages', filter: conditions.join(' and ') };\n  }\n\n  const folderId = folderIdsByName[rule.folder];\n  if (!folderId) {\n    throw new Error(`Outlook folder \"LLMailSorter/${rule.folder}\" not found.`);\n  }\n  return { path: `/me/mailFolders/${folderId}/messages`, filter: conditions.join(' and ') };\n}\n\nreturn RETENTION_RULES.map((rule) => ({ json: { ...rule, ...buildRequest(rule) } }));"
      },
