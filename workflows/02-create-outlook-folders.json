      "parameters": {
        "jsCode": "// One sub-folder per category. Every sorted email is moved to one of them.\nconst categoryFolders = [\n  'Subscriptions', 'Invoices', 'Jobs', 'Admin', 'Orders',\n  'Personal', 'Security', 'Junk', 'Other', 'Not sure',\n];\n\nconst parentFolderId = $('Create parent folder').first().json.id;\n\nreturn categoryFolders.map((name) => ({ json: { name, parentFolderId } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
