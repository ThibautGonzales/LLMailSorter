    {
      "parameters": {
        "jsCode": "// Maps each classify-email category id to its Outlook folder (a sub-folder of LLMailSorter).\nconst CATEGORY_FOLDERS = {\n  subscriptions: 'Subscriptions',\n  invoices: 'Invoices',\n  jobs: 'Jobs',\n  admin: 'Admin',\n  orders: 'Orders',\n  personal: 'Personal',\n  security: 'Security',\n  trash: 'Junk',\n  other: 'Other',\n  notSure: 'Not sure',\n};\n\nconst parentFolder = $input.first().json.value[0];\nif (!parentFolder) {\n  throw new Error('Outlook folder \"LLMailSorter\" not found. Run \"02 - Create Outlook folders\" first.');\n}\n\nconst folderIdsByName = Object.fromEntries(\n  parentFolder.childFolders.map((folder) => [folder.displayName, folder.id]),\n);\n\nreturn $('Attach category').all().map((email) => {\n  const folderName = CATEGORY_FOLDERS[email.json.category] ?? CATEGORY_FOLDERS.notSure;\n  const folderId = folderIdsByName[folderName];\n  if (!folderId) {\n    throw new Error(`Outlook folder \"LLMailSorter/${folderName}\" not found. Run \"02 - Create Outlook folders\" first.`);\n  }\n  return { json: { ...email.json, folderName, folderId } };\n});"
      },
